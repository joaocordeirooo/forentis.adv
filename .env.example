# Copie para .env e preencha. Nunca envie o .env para o Git.



# OpenAI
OPENAI_API_KEY=
OPENAI_MODELO_ANALISE=gpt-4.1-mini
OPENAI_MODELO_CNPJ=gpt-4.1-mini
# Modelo que lê os PDFs (o mesmo do n8n). Precisa aceitar arquivo/imagem.
OPENAI_MODELO_PDF=gpt-5.6-luna
# Modelo do chat da DEX (precisa aceitar chamada de funções).
OPENAI_MODELO_DEX=gpt-4.1-mini

# ChatGuru (as mesmas credenciais da credencial "ChatGuru API" do n8n)
CHATGURU_URL=https://s20.chatguru.app/api/v1
CHATGURU_KEY=
CHATGURU_ACCOUNT_ID=
CHATGURU_PHONE_ID=
CHATGURU_DIALOG_ID=66a78e0c15feb77151d1ce7c
CHATGURU_DIALOG_BLOQUEAR_URA=65f86296767a1bfe9ca6db87
CHATGURU_CAMPO_DOCUMENTOS=Documentos_Pendentes
CHATGURU_ESPERA_NOVO_CHAT=60

# E-mail para as empresas (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Modo teste: WhatsApp e e-mail vão só para os destinos abaixo, e no máximo LIMITE_TAREFAS_TESTE tarefas por execução.
MODO_TESTE=true
TELEFONE_TESTE=554999832158
EMAIL_TESTE=
LIMITE_TAREFAS_TESTE=3

# Travas
DIAS_SEM_REPETIR=7
MAX_COBRANCAS_CLIENTE=3
MAX_CARACTERES_TEMPLATE=250
MAX_ARQUIVOS_ANALISE=6
MAX_ARQUIVOS_CNPJ=4

# Agenda da análise automática (fuso de São Paulo). Vazio = só manual. Dias: 0=dom ... 6=sáb.
AGENDA_HORARIOS=06:30
AGENDA_DIAS=1,2,3,4,5

# Atendimento externo: false = "Material coletado" só simula (não inicia tarefas reais no Lawyertool).
ATENDIMENTO_EXECUTAR_LAWYERTOOL=false
# Rastreador do carro do atendente: "simulado" (padrão) até ligar a API real
RASTREADOR_PROVEDOR=simulado

# Proteção da API: as chamadas precisam do cabeçalho x-api-key com este valor.
API_KEY=

# Onde ficam os dados enquanto não há banco (solicitações, execuções, anexos).
PASTA_DADOS=.dados
