# Copie para .env e preencha. Nunca envie o .env para o Git.



# OpenAI
OPENAI_API_KEY=
OPENAI_MODELO_ANALISE=gpt-4.1-mini
OPENAI_MODELO_CNPJ=gpt-4.1-mini
# Modelo que lê os PDFs (o mesmo do n8n). Precisa aceitar arquivo/imagem.
OPENAI_MODELO_PDF=gpt-5.6-luna
# Modelo do chat da DEX (precisa aceitar chamada de funções).
OPENAI_MODELO_DEX=gpt-4.1-mini

# ChatGuru (as mesmas credenciais da credencial "ChatGuru API" do n8n)
CHATGURU_URL=https://s20.chatguru.app/api/v1
CHATGURU_KEY=
CHATGURU_ACCOUNT_ID=
CHATGURU_PHONE_ID=
CHATGURU_DIALOG_ID=66a78e0c15feb77151d1ce7c
CHATGURU_DIALOG_BLOQUEAR_URA=65f86296767a1bfe9ca6db87
CHATGURU_CAMPO_DOCUMENTOS=Documentos_Pendentes
CHATGURU_ESPERA_NOVO_CHAT=60

# Caixa de e-mail do Forentis (caixa única de solicitações, hospedagem damadvogados.com.br)
SMTP_HOST=mail.damadvogados.com.br
SMTP_PORT=587
SMTP_USER=documentos@damadvogados.com.br
SMTP_PASS=
SMTP_FROM="DAM Advogados - Solicitações" <documentos@damadvogados.com.br>
# Leitura da caixa (IMAP). Vazio = mesmo servidor do SMTP, porta 993.
IMAP_HOST=
IMAP_PORT=993
IMAP_PASTA_ENTRADA=INBOX
IMAP_PASTA_ENVIADOS=INBOX.Sent
# true = guarda uma cópia de cada envio na pasta Enviados (aparece no webmail/Outlook)
EMAIL_COPIAR_ENVIADOS=true
EMAIL_MAX_ANEXOS_MB=15
# Leitura das respostas (caixa de entrada): de quantos em quantos minutos (0 = só manual)
EMAIL_LEITURA_MINUTOS=5
# Conversa aparece como "sem resposta" depois de N dias do último envio
EMAIL_DIAS_SEM_RESPOSTA=7
# Comenta na tarefa do Lawyertool quando chega resposta ou devolução
EMAIL_COMENTAR_RESPOSTAS=true

# Modo teste: WhatsApp e e-mail vão só para os destinos abaixo, e no máximo LIMITE_TAREFAS_TESTE tarefas por execução.
MODO_TESTE=true
TELEFONE_TESTE=554999832158
EMAIL_TESTE=
LIMITE_TAREFAS_TESTE=3

# Travas
DIAS_SEM_REPETIR=7
MAX_COBRANCAS_CLIENTE=3
MAX_CARACTERES_TEMPLATE=250
MAX_ARQUIVOS_ANALISE=6
MAX_ARQUIVOS_CNPJ=4

# Agenda da análise automática (fuso de São Paulo). Vazio = só manual. Dias: 0=dom ... 6=sáb.
AGENDA_HORARIOS=06:30
AGENDA_DIAS=1,2,3,4,5

# Atendimento externo: false = "Material coletado" só simula (não inicia tarefas reais no Lawyertool).
ATENDIMENTO_EXECUTAR_LAWYERTOOL=false
# Usuários do Lawyertool (ids) cujas tarefas de atendimento podem ser iniciadas/concluídas. Teste: 115 (João Cordeiro).
ATENDIMENTO_USUARIOS_LIBERADOS=115
# Rastreador do carro do atendente: "simulado" (padrão) até ligar a API real
RASTREADOR_PROVEDOR=simulado

# Proteção da API: as chamadas precisam do cabeçalho x-api-key com este valor.
API_KEY=

# Onde ficam os dados enquanto não há banco (solicitações, execuções, anexos).
PASTA_DADOS=.dados

# n8n (servidor interno) — cobrança de documentos pelo ChatGuru
# Deixe N8N_COBRANCA_WEBHOOK_URL vazio enquanto o n8n não tiver rota acessível: o botão "Cobrar" fica desligado.
N8N_COBRANCA_WEBHOOK_URL=
N8N_TOKEN=
N8N_RETORNO_TOKEN=
N8N_TIMEOUT=30
# Endereço do Forentis que o servidor do n8n consegue acessar (para avisar o resultado). Ex.: http://192.168.0.20:3000
FORENTIS_URL=

# Link para abrir a tarefa no Lawyertool pelo painel ({id} = número da tarefa). Reinicie o npm run dev após mudar.
NEXT_PUBLIC_LAWYERTOOL_TAREFA_URL=https://lawyertool.damadvogados.com.br:6080/tar/tarefa/{id}
